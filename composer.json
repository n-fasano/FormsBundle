{
    "name": "fasano/forms-bundle",
    "description": "Generate Symfony forms from your DTOs.",
    "type": "symfony-bundle",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Nicolas Fasano",
            "email": "fasano.nm@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../contracts/primitives"
        }
    ],
    "require": {
        "symfony/http-kernel": "7.3",
        "symfony/dependency-injection": "7.3",
        "symfony/form": "7.3",
        "symfony/routing": "7.3",
        "symfony/validator": "7.3",
        "symfony/config": "7.3",
        "contract/primitives": "1.0"
    },
    "autoload": {
        "psr-4": {
            "Fasano\\FormsBundle\\": "src/"
        }
    }
}
